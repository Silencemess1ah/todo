<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="task_V003__constraints" author="Sergey">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tasks"/>
        </preConditions>

        <addNotNullConstraint tableName="tasks" columnName="name" columnDataType="VARCHAR(64)"/>
        <addNotNullConstraint tableName="tasks" columnName="description" columnDataType="VARCHAR(256)"/>
        <addNotNullConstraint tableName="tasks" columnName="dead_line" columnDataType="TIMESTAMP"/>
        <addNotNullConstraint tableName="tasks" columnName="status" columnDataType="VARCHAR(24)"/>

        <sql>
            ALTER TABLE tasks
            ADD CONSTRAINT ck_task_status
            CHECK (status IN ('TODO', 'IN_PROGRESS', 'DONE'));
        </sql>

    </changeSet>

</databaseChangeLog>